meta {
  name: Reservation Detail
  type: http
  seq: 3
}

get {
  url: {{baseUrl}}/reservation/{{reservationId}}
  body: none
}

headers {
  Authorization: Bearer {{bearerToken}}
}

tests {
  test("detail should succeed", function() {
    expect(res.status).to.equal(200);
    expect(res.body.code).to.equal(200);
  });
}

