meta {
  name: Venue Recommendation
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/recommendation/venues
  body: json
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "sportKeyword": "{{sportKeyword}}",
    "preferredUnitMinutes": {{preferredUnitMinutes}},
    "expectedPeopleCount": {{expectedPeopleCount}},
    "maxBudget": {{maxBudget}},
    "preferLowPrice": {{preferLowPrice}},
    "expectedStartUnit": {{expectedStartUnit}},
    "expectedEndUnit": {{expectedEndUnit}},
    "topN": {{topN}}
  }
}

tests {
  test("recommendation should succeed", function() {
    expect(res.status).to.equal(200);
    expect(res.body.code).to.equal(200);
    expect(res.body.data).to.be.an('array');
  });
}

docs {
  ```json
  {
    "code": 200,
    "message": "Success",
    "data": [
      {
        "venueId": 1,
        "venueName": "主体体育馆",
        "resourceId": 2,
        "resourceName": "主体体育馆 A5",
        "estimatedPrice": 42,
        "unitMinutes": 10,
        "capacity": 4,
        "score": 120.8,
        "reasonList": [
          "场地类型与用户运动偏好高度匹配",
          "时间片粒度更细，适合分钟级灵活预约"
        ]
      }
    ]
  }
  ```
}
