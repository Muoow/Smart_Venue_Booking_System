meta {
  name: Demo Login
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/auth/login
  body: json
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "username": "{{username}}",
    "password": "{{password}}"
  }
}

script:post-response {
  if (res.body && res.body.data) {
    bru.setVar("bearerToken", res.body.data);
  }
}

tests {
  test("login should succeed", function() {
    expect(res.status).to.equal(200);
    expect(res.body.code).to.equal(200);
    expect(res.body.data).to.be.a('string');
  });
}

docs {
  ```json
  {
    "code": 200,
    "message": "Success",
    "data": "jwt-token"
  }
  ```
}
